# nullifier 生产环境环境变量样例
#
# 复制为 .env 或直接导出到进程环境。注意：
#   - viper 只会自动加载名为 config.yaml 的配置文件；
#     configs/config.production.yaml **不会**被自动读取，
#     用 CONFIG_FILE 显式指定（推荐的用法，不用改名覆盖开发配置）：
#       CONFIG_FILE=./configs/config.production.yaml
#     或者完全依赖本文件里的环境变量。
#   - CONFIG_FILE 指定的文件不存在时服务**直接启动失败**，
#     不会静默回退到开发配置。
#   - 环境变量优先级高于配置文件。
#   - server.mode 为 release/prod/production 时，
#     CRYPTO_VK_PATH 与 SERVER_ADMIN_BEARER_TOKEN 都是必填，缺一个服务就起不来。
#   - release 模式下还必须配 CRYPTO_ELIGIBILITY_ROOT 与 CRYPTO_ELIGIBILITY_VK_PATH：
#     没有它们，服务端无法强制「一人一票」，服务同样起不来。
#   - release 模式下服务不会在启动时改表：先跑 `nullifier-server -migrate`，
#     再起服务。迁移步骤不需要这两个密钥。
#
# 用配置文件时把下面这行取消注释；完全用环境变量驱动时保持注释。
# CONFIG_FILE=./configs/config.production.yaml

SERVER_MODE=release

# 管理端 Bearer Token。必填，且必须是长期稳定的值：
# 留空会直接导致服务启动失败（临时 token 每次重启都会变，多副本之间还不一样）。
SERVER_ADMIN_BEARER_TOKEN=

# 允许访问 HTTP API 的浏览器来源。多个用**空格**分隔（不是逗号）。
# 门户与后端不同源时必须设置，否则浏览器会直接拦掉所有请求。
SERVER_CORS_ALLOWED_ORIGINS=https://vote.example.com

# 选票证明验证密钥路径。release 模式必填。
CRYPTO_VK_PATH=./keys/verifying.key

# 资格名单的树根（64 位十六进制的域元素）与资格电路的验证密钥路径。
#
# release 模式**两个都必须配**，缺一个服务就起不来 —— 没有它们，服务端无法
# 强制「一人一票」。两者必须成对出现（只配一个任何模式都启动失败）。
#
# root 来自离线名单工具的产物（`nullifier-eligibility-list` 的 root.json）；
# verifying key 来自 `nullifier-keygen -circuit eligibility`。
#
# 两个都要填（release 模式必填，缺一个服务就起不来）。填好之后大致长这样：
#   CRYPTO_ELIGIBILITY_ROOT=16e575fde58737063900c70ffbe3480860ca3e0c73641281cdc5c7ab79ecafd0
#   CRYPTO_ELIGIBILITY_VK_PATH=./keys/eligibility-verifying.key
#
# ⚠️ 服务端**只要 root**：它据此验证「这个人的资格在名单里」，
#    却无法把资格对应到任何成员。成员包绝不能进服务端。
CRYPTO_ELIGIBILITY_ROOT=
CRYPTO_ELIGIBILITY_VK_PATH=

# 凭证签发密钥的落盘位置与轮换周期。
CRYPTO_ISSUER_KEY_PATH=issuer_keys.json
CRYPTO_ISSUER_ROTATE_DAYS=90

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anonvote
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# 连接池。留空则用默认值（25 / 5 / 3600 秒）。
# 不设上限的话，database/sql 默认不限制连接数，并发一高就会打爆 PG 的
# max_connections；连接最大存活时间则是为了定期回收长连接。
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=3600
